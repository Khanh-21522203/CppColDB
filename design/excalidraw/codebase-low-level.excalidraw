      "x": 720, "y": 322,
      "width": 380, "height": 160,
      "strokeColor": "#b45309",
      "backgroundColor": "#1e293b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
