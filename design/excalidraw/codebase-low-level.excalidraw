      "roundness": {"type": 3}
    },
    {
      "type": "text",
      "id": "compress_text",
      "x": 728, "y": 330,
      "width": 364, "height": 146,
      "text": "Pending DataVector (uncompressed rows)\n    ↓  ColumnChunk::Flush()\nSelectCompression() → codec:\n  RLE:       repeated values (enums, status cols)\n  DELTA:     monotone sequences (timestamps, IDs)\n  BIT_PACK:  small integers (flags, short ints)\n  DICTIONARY: low-cardinality strings/enums\n  UNCOMPRESSED: fallback\n    ↓\n[SegmentHeader 9B][null bitmap][compressed data]\n    ↓  BufferManager::AllocateBlock()\nColumnSegment{BlockId, type, min, max, has_nulls}",
      "originalText": "Pending DataVector (uncompressed rows)\n    ↓  ColumnChunk::Flush()\nSelectCompression() → codec:\n  RLE:       repeated values (enums, status cols)\n  DELTA:     monotone sequences (timestamps, IDs)\n  BIT_PACK:  small integers (flags, short ints)\n  DICTIONARY: low-cardinality strings/enums\n  UNCOMPRESSED: fallback\n    ↓\n[SegmentHeader 9B][null bitmap][compressed data]\n    ↓  BufferManager::AllocateBlock()\nColumnSegment{BlockId, type, min, max, has_nulls}",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 30172,
      "version": 1,
      "versionNonce": 30173,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": "compress_chain",
      "lineHeight": 1.25
    },

