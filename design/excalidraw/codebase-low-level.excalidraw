    {
      "type": "rectangle",
      "id": "mvcc_rect",
      "x": 720, "y": 82,
      "width": 380, "height": 200,
      "strokeColor": "#1e3a5f",
      "backgroundColor": "#1e293b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 30150,
      "version": 1,
      "versionNonce": 30151,
      "isDeleted": false,
      "groupIds": [],
