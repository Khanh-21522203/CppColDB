      "link": null,
      "locked": false,
      "roundness": {"type": 3}
    },
    {
      "type": "text",
      "id": "mvcc_text",
      "x": 728, "y": 90,
      "width": 364, "height": 186,
      "text": "VersionMarker per row:\n  type: INSERT | DELETE | UPDATE\n  tx_id: TransactionId\n  commit_time: timestamp_t  // INVALID=uncommitted\n\nVisibility check (snapshot isolation):\n  row.insert.commit_time < tx.start_time → VISIBLE\n  row.delete.commit_time < tx.start_time → DELETED\n\nFast path: AllInsertedVisibleTo(tx.start_time)\n  → true if no uncommitted / no DELETE markers\n  → skip per-row check entirely (clean scan)\n\nVersionInfo::MarkInserted(row_off, tx_id)\nVersionInfo::CommitInsert(tx_id, commit_time)",
      "originalText": "VersionMarker per row:\n  type: INSERT | DELETE | UPDATE\n  tx_id: TransactionId\n  commit_time: timestamp_t  // INVALID=uncommitted\n\nVisibility check (snapshot isolation):\n  row.insert.commit_time < tx.start_time → VISIBLE\n  row.delete.commit_time < tx.start_time → DELETED\n\nFast path: AllInsertedVisibleTo(tx.start_time)\n  → true if no uncommitted / no DELETE markers\n  → skip per-row check entirely (clean scan)\n\nVersionInfo::MarkInserted(row_off, tx_id)\nVersionInfo::CommitInsert(tx_id, commit_time)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 30152,
      "version": 1,
      "versionNonce": 30153,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": "mvcc_rect",
      "lineHeight": 1.25
    },

